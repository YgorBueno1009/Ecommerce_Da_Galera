DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ecommerce
# Produção: use svc_node_js (membro de ecommerce_app_group), não superuser.
DB_USER=svc_node_js
DB_PASSWORD=replace-with-your-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=3600
PORT=3000
NODE_ENV=development
# Primeira origem = base do link /redefinir-senha?token=... (recuperação de senha).
# Várias origens: separe por vírgula (CORS); só a primeira entra no link do e-mail.
CORS_ORIGIN=http://localhost:4200
